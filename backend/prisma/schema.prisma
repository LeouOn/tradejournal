datasource db {
  provider = "sqlite" // We use sqlite by default for easy zero-setup running. To switch to PostgreSQL, change to "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  user_id           String     @id @default(uuid())
  email             String     @unique
  password_hash     String
  subscription_tier String     @default("BASIC")
  created_at        DateTime   @default(now())
  accounts          Account[]
  playbooks         Playbook[]
}

model Account {
  account_id         String             @id @default(uuid())
  account_name       String
  broker_name        String
  initial_balance    Decimal
  currency           String             @default("USD")
  user_id            String
  user               User               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  trades             Trade[]
  chat_messages      ChatMessage[]
  chat_sessions      ChatSession[]
  daily_charts       DailyChart[]
  weekly_reports     WeeklyReport[]
  coach_observations CoachObservation[]
}

model Trade {
  trade_id       String          @id @default(uuid())
  symbol         String
  status         String          @default("CLOSED") // OPEN, CLOSED
  manual_status  Boolean         @default(false)
  net_pnl        Decimal         @default(0.0)
  r_multiple     Decimal         @default(0.0)
  duration       Int             @default(0) // In seconds
  rules_followed Boolean         @default(true)
  stop_loss      Decimal?
  notes          String?
  notes_vector   String? // Comma-separated floats representing embeddings
  bias           String          @default("RANGE") // LONG, SHORT, RANGE
  bias_reversal  Boolean         @default(false)
  trade_type     String          @default("BREAKOUT") // BREAKOUT, RANGE
  account_id     String
  account        Account         @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  executions     Execution[]
  trade_tags     TradeTag[]
  market_context MarketContext[]
  created_at     DateTime        @default(now())
}

model Execution {
  execution_id        String   @id @default(uuid())
  fill_price          Decimal
  quantity            Decimal
  side                String // BUY, SELL
  execution_timestamp DateTime
  trade_id            String
  trade               Trade    @relation(fields: [trade_id], references: [trade_id], onDelete: Cascade)
}

model Tag {
  tag_id       String     @id @default(uuid())
  tag_category String // Setup, Emotion, Error
  tag_name     String     @unique
  color_code   String
  trade_tags   TradeTag[]
}

model TradeTag {
  trade_tag_id String @id @default(uuid())
  trade_id     String
  tag_id       String
  trade        Trade  @relation(fields: [trade_id], references: [trade_id], onDelete: Cascade)
  tag          Tag    @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade)

  @@unique([trade_id, tag_id])
}

model Playbook {
  playbook_id  String @id @default(uuid())
  setup_name   String
  description  String
  ruleset_json String // JSON string representation of edge guidelines
  user_id      String
  user         User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model MarketContext {
  context_id     String  @id @default(uuid())
  regime_type    String // e.g., "Bullish - Low Volatility"
  vix_level      Decimal
  fed_funds_rate Decimal
  spx_trend      String // e.g., "ABOVE_200SMA", "BELOW_200SMA"
  trade_id       String
  trade          Trade   @relation(fields: [trade_id], references: [trade_id], onDelete: Cascade)
}

model ChatSession {
  session_id String        @id @default(uuid())
  title      String
  account_id String
  account    Account       @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  messages   ChatMessage[]
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@index([account_id])
}

model ChatMessage {
  message_id  String       @id @default(uuid())
  role        String // "user", "assistant"
  content     String
  image_data  String?
  is_summary  Boolean      @default(false)
  is_archived Boolean      @default(false)
  created_at  DateTime     @default(now())
  account_id  String
  account     Account      @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  session_id  String?
  session     ChatSession? @relation(fields: [session_id], references: [session_id], onDelete: SetNull)
}

model DailyChart {
  chart_id   String   @id @default(uuid())
  date_str   String // The date string, e.g. "5-26-2026"
  image_path String // The path where the uploaded image is saved on the backend server
  account_id String
  account    Account  @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  created_at DateTime @default(now())
}

model WeeklyReport {
  report_id  String   @id @default(uuid())
  start_date DateTime
  end_date   DateTime
  summary_md String
  account_id String
  account    Account  @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  created_at DateTime @default(now())
}

model CoachObservation {
  observation_id   String   @id @default(uuid())
  account_id       String
  observation_type String // "QUALITATIVE", "QUANTITATIVE", "RULE_VIOLATION"
  content          String
  severity         Int      @default(1) // 1-5 scale
  related_trade_id String?
  created_at       DateTime @default(now())

  account Account @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
}
