# Port configuration for Express backend
PORT=5000

# Database URL.
# 1. SQLite fallback configuration (default - zero setup required):
DATABASE_URL="file:./dev.db"

# 2. PostgreSQL production configuration (uncomment to use PostgreSQL docker service):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradejournal?schema=public"

# AI Integration Router Configurations
# Points to local LM Studio by default
OPENAI_BASE_URL="http://localhost:1234/v1"
OPENAI_API_KEY="lm-studio"
LLM_MODEL="local-model-identifier" # Will use first available if blank

# Optional: Cloud OpenAI key (uncomment to override)
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

# Federal Reserve Economic Data (FRED) API Key
# Sign up at https://fred.stlouisfed.org/api/keys.html (optional)
FRED_API_KEY=""
